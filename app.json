{
  "expo": {
    "name": "TaniSync",
    "slug": "mage12-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mage12mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icontampilanawal/icon-aplikasi.png",
        "backgroundColor": "#FBF8F0"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.ryuseieee.mage12mobile"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TaniSync memerlukan akses lokasi untuk menampilkan prakiraan cuaca kebun yang akurat dan menghubungkan kamu dengan komunitas petani di sekitarmu."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TaniSync memerlukan izin galeri untuk mengunggah foto profil, kebun, dan postingan komunitas.",
          "cameraPermission": "TaniSync memerlukan izin kamera untuk mengambil foto perkembangan tanaman secara langsung."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.694319697914-5ov6mf48s2votq1htk2tm5toeiap7jbs"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3FA86B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b959b0da-c5e9-4ad2-b886-49b5c979a64c"
      }
    },
    "icon": "./assets/images/icontampilanawal/icon-aplikasi.png",
    "splash": {
      "image": "./assets/images/icontampilanawal/icon-aplikasi.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F0"
    }
  }
}